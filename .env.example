# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=5000
NODE_ENV=development

# =============================================================================
# SPOTIFY API CREDENTIALS
# Get these from: https://developer.spotify.com/dashboard
# =============================================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# =============================================================================
# SPOTIFY REDIRECT URI
# For local development: http://localhost:5000/auth/callback
# For production: https://your-portfolio.com/auth/callback
# IMPORTANT: Must match exactly what's configured in Spotify Dashboard
# =============================================================================
SPOTIFY_REDIRECT_URI=http://localhost:5000/auth/callback

# =============================================================================
# SESSION SECRET
# Used for session management (generate a random string for production)
# =============================================================================
SESSION_SECRET=your_random_secret_here


ALLOWED_ORIGINS=
